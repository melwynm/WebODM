WEBODM_BASE_URL=http://localhost:8000
# Preferred for long-lived automation.
# WEBODM_API_KEY=your_permanent_api_key_here
# Optional: set a preloaded credential instead of calling webodm_authenticate.
# WEBODM_TOKEN=your_jwt_or_api_key_here
# Optional when using WEBODM_TOKEN. Supported values: Bearer, Token.
# WEBODM_TOKEN_TYPE=Bearer
