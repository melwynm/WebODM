# Copy to .env on the production host and replace every placeholder.
# Keep this file out of screenshots, tickets, and client handoffs after filling it in.

WO_HOST=webodm.example.com
WO_PORT=443
WO_SSL=YES
WO_SSL_INSECURE_PORT_REDIRECT=80
WO_DEBUG=NO
WO_DEV=NO

# Generate once and keep stable across container rebuilds.
WO_SECRET_KEY=replace-with-a-long-random-secret

# Prefer host bind paths for commercial operations so backups and restores are inspectable.
WO_MEDIA_DIR=/srv/webodm/media
WO_DB_DIR=/srv/webodm/postgres
WO_BACKUP_DIR=/srv/webodm/backups
WO_BACKUP_RETENTION_DAYS=14

WO_BROKER=redis://broker
WO_DEFAULT_NODES=1
WEB_CONCURRENCY=4
WO_API_ANON_THROTTLE_RATE=120/min
WO_API_USER_THROTTLE_RATE=1200/min

# Optional but recommended for browser/command intake; constrains OneDrive imports to this root.
WO_ONEDRIVE_INTAKE_DIR=/srv/webodm/onedrive-intake

# Optional AirTwin integration. Generate the secret outside source control.
AIRTWIN_WEBHOOK_ENABLED=NO
AIRTWIN_WEBHOOK_URL=http://airtwin:8080/api/integrations/webodm/events
AIRTWIN_WEBHOOK_SECRET=replace-with-a-long-random-integration-secret
AIRTWIN_WEBHOOK_TIMEOUT_SECONDS=10
AIRTWIN_WEBHOOK_MAX_RETRIES=5
AIRTWIN_WEBHOOK_RETRY_BASE_SECONDS=5
AIRTWIN_OUTPUT_RETENTION_DAYS=30
AIRTWIN_DOCKER_NETWORK=airtwin

# Optional settings override for ALLOWED_HOSTS, CORS, mail, SSO, and trusted proxy settings.
WO_SETTINGS=/srv/webodm/settings_override.py
